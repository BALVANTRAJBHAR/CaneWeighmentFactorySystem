# ============================================================
# CaneFactory API - environment variables (.env.example)
# Copy to your environment / launch profile. NEVER commit real
# secrets to Git. All values below are placeholders.
# ============================================================

# --- Database ---
# Production: SQL Server 2019 Express (local factory server)
CANE_DB_PROVIDER=SqlServer
CANE_CONNECTION_STRING=Server=localhost;Database=AFFLLPCaneFactory;User Id=canefactory_app;Password=AFFLLP@2026;TrustServerCertificate=True;Encrypt=True

# Development-only fallback (containers/CI without SQL Server):
# CANE_DB_PROVIDER=Sqlite
# CANE_CONNECTION_STRING=Data Source=canefactory_dev.db

# --- JWT signing secret (min 64 random chars). Generate:
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 64 | % {[char]$_})
CANE_JWT_SECRET=<RANDOM_64_CHAR_SECRET>

# --- AES-256 encryption passphrase for stored secrets (SMS/camera credentials, Aadhaar) ---
CANE_ENCRYPTION_KEY=<RANDOM_64_CHAR_PASSPHRASE>

# --- Initial Developer account temporary password (forced change on first login) ---
CANE_SEED_DEV_PASSWORD=<TEMP_DEVELOPER_PASSWORD>

# --- Phase 6: camera evidence image storage root (leave unset to use the Developer Dashboard
#     "ImageStorageRoot" system setting instead, default D:\CanePaymentData) ---
# CANE_IMAGE_STORAGE_ROOT=D:\CanePaymentData

# --- Camera simulator mode: set true ONLY for demo/dev without physical camera hardware.
#     NEVER set true in production - real ONVIF/ISAPI/RTSP capture is skipped when true. ---
CANE_CAMERA_SIMULATOR=false

# --- RTSP capture requires the ffmpeg binary on PATH (not needed for ISAPI/ONVIF cameras) ---

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://0.0.0.0:5001;http://0.0.0.0:5000
