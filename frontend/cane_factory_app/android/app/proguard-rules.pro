# These components are launched by Android or the Flutter method channel.
# Manifest-referenced classes are normally retained automatically; explicit
# rules keep that contract clear if the Android Gradle plugin changes.
-keep class com.affllp.canefactory.cane_factory_app.MainActivity { *; }
-keep class com.affllp.canefactory.cane_factory_app.GatewayService { *; }
-keep class com.affllp.canefactory.cane_factory_app.GatewayBootReceiver { *; }
