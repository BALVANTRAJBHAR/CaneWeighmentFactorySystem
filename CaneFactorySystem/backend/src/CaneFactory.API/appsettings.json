    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "EncryptionKey": ""
  },
  "Seed": {
    "DeveloperPassword": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5000", "http://localhost:8080" ]
  }
}
